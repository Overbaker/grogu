# Target iOS / iPadOS device Tailscale IP (required)
GROGU_DEVICE_IP=100.64.0.10

# Gateway HTTP bind host (recommended: your Linux host's Tailscale IPv4, or 127.0.0.1)
GROGU_BIND_HOST=127.0.0.1
GROGU_GATEWAY_PORT=18830
GROGU_WDA_FORWARD_PORT=18832
GROGU_RSD_RPC_PORT=18833
GROGU_MCP_HTTP_PORT=18831

# WDA runner bundle ID (auto-detected after installation if left default)
GROGU_WDA_BUNDLE_ID=com.facebook.WebDriverAgentRunner.xctrunner

# Companion MacBook Tailscale IP (optional, for remote Xcode/Impactor builds)
GROGU_MAC_TAILSCALE_IP=100.64.0.20

# Path to pymobiledevice3 binary / Python interpreter (auto-detected if omitted)
# GROGU_PMD_PYTHON=/path/to/pymobiledevice3/bin/python

# Runtime state directories (default: ~/.config/grogu and ~/.pymobiledevice3)
# GROGU_STATE_DIR=~/.config/grogu
# GROGU_PAIRING_DIR=~/.pymobiledevice3
# GROGU_OUTPUT_DIR=/tmp/grogu

# Tier-1 Ultra-low-latency Decision API (OpenRouter Gemini Decision-1, 0 output tokens)
# OPENROUTER_API_KEY=sk-or-v1-...
# GROGU_DECISION_API_KEY=sk-or-v1-...
# GROGU_DECISIONS_URL=https://openrouter.ai/api/alpha/decisions
# GROGU_DECISION_MODEL=google/gemini-decision-1

# Tier-2 OpenAI-compatible fast LLM planner for multi-step Siri / /api/ai/act tasks
# GROGU_LLM_BASE_URL=https://api.openai.com/v1
# GROGU_LLM_API_KEY=sk-...
# GROGU_LLM_MODEL=gpt-4o-mini
# GROGU_LLM_DISABLE_THINKING=true

# Default AI routing engine: auto | fast-llm | pi | decision-1
# GROGU_DEFAULT_AGENT=auto

# Optional warm Pi coding-agent (`pi --mode rpc`) bridge
# GROGU_PI_BIN=pi
# GROGU_PI_PROVIDER=openai
# GROGU_PI_MODEL=gpt-4o-mini
# GROGU_PI_THINKING=off
